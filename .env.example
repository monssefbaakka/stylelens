# Copier en .env puis adapter
POSTGRES_DB=stylelens
POSTGRES_USER=stylelens
POSTGRES_PASSWORD=stylelens
POSTGRES_PORT=5432

# Dimension des embeddings en base (512 = modèle fine-tuné P3 ; 960 = mobilenet_v3_large).
# Fixée à la création de la base : pour en changer, docker compose down -v.
STYLELENS_EMBEDDING_DIM=512

# Service IA : checkpoint fine-tuné (dossier ml/models monté sur /models).
# Laisser MODEL_CHECKPOINT vide pour servir le backbone ImageNet MODEL_NAME.
MODEL_CHECKPOINT=/models/resnet50-ft/model.pt
MODEL_NAME=resnet50

# Photos du catalogue servies par l'API
STYLELENS_DATA_DIR=./ml/data/fashion-product-images-small

# Ports exposés
INFERENCE_PORT=8000
CATALOG_API_PORT=8080
FRONTEND_PORT=3000
